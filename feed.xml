---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url }}</link>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    <description>{{ site.description | xml_escape }}</description>
    <language>es</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {%- assign lista = site.reflexiones | reverse %}
    {%- for doc in lista limit: 30 %}
    <item>
      <title>{{ doc.title | xml_escape }}</title>
      <link>{{ doc.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ doc.url | absolute_url }}</guid>
      <pubDate>{{ doc.date | date_to_rfc822 }}</pubDate>
      <author>{{ site.author.name | xml_escape }}</author>
      {%- for t in doc.temas %}
      <category>{{ t | xml_escape }}</category>
      {%- endfor %}
      <description>{% if doc.description %}{{ doc.description | xml_escape }}{% else %}{{ doc.content | strip_html | truncatewords: 40 | xml_escape }}{% endif %}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
